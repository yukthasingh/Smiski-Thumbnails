{
    "manifest_version": 3,
    "name": "Smisk-tube",
    "description": "Smiski cameos on every Youtube video thumbnail!",
    "version": "1.0.0",
    "license": null,
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://*youtube.com/*",
        "https://*www.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://youtube.com/*",
                "https://www.youtube.com/*",
                "https://*youtube.com/*",
                "https://*www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": [
                "document_idle",
                "document_end",
                "document_start"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}