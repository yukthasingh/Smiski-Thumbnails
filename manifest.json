{
    "manifest_version": 3,
    "name": "Smisk-tube",
    "description": "Smiski cameos on every Youtube video thumbnail!",
    "version": "1.0.0",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
    ],
    "action": {
        "default+popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://youtube.com/*",
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/s_*.png"
            ],
            "matches": [
                "https://youtube.com/*",
                "https://www.youtube.com/*"
            ]
        }
    ]
}